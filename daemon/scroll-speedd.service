[Unit]
Description=Mouse wheel scroll speed multiplier
After=systemd-udevd.service

[Service]
Environment=SCROLL_SPEED_FILE=@CONFIG@
ExecStartPre=-/sbin/modprobe uinput
ExecStart=/usr/bin/python3 -u /usr/local/bin/scroll-speedd
Restart=on-failure
RestartSec=1
Nice=-10

[Install]
WantedBy=multi-user.target
